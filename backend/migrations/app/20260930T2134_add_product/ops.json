    "execute": [
      {
        "description": "create table \"Product\"",
        "sql": "CREATE TABLE \"public\".\"Product\" (\n  \"archivedAt\" timestamptz,\n  \"categoryId\" int4,\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"description\" text,\n  \"id\" SERIAL NOT NULL,\n  \"isAvailable\" bool DEFAULT true NOT NULL,\n  \"maxQuantity\" int4,\n  \"minQuantity\" int4 NOT NULL,\n  \"name\" text NOT NULL,\n  \"photo\" text,\n  \"priceMillimes\" int4 NOT NULL,\n  \"quantityStep\" int4 NOT NULL,\n  \"saleUnit\" text NOT NULL,\n  \"storeId\" int4 NOT NULL,\n  \"updatedAt\" timestamptz NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"Product_saleUnit_check_e4ec9d4d\" CHECK (\"saleUnit\" IN ('PIECE', 'KG', 'L')),\n  CONSTRAINT \"product_max_aligned_to_step_7a1e96ae\" CHECK (\"maxQuantity\" IS NULL OR \"maxQuantity\" % NULLIF(\"quantityStep\", 0) = 0),\n  CONSTRAINT \"product_max_not_below_min_d677fabe\" CHECK (\"maxQuantity\" IS NULL OR \"maxQuantity\" >= \"minQuantity\"),\n  CONSTRAINT \"product_min_aligned_to_step_6feb37a8\" CHECK (\"minQuantity\" % NULLIF(\"quantityStep\", 0) = 0),\n  CONSTRAINT \"product_min_quantity_positive_b981200f\" CHECK (\"minQuantity\" > 0),\n  CONSTRAINT \"product_name_not_blank_8e77c20d\" CHECK (length(btrim(\"name\")) > 0),\n  CONSTRAINT \"product_price_positive_a55c5a5a\" CHECK (\"priceMillimes\" > 0),\n  CONSTRAINT \"product_quantity_step_positive_904d0517\" CHECK (\"quantityStep\" > 0)\n)",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify table \"Product\" exists",
        "sql": "SELECT (to_regclass($1)) IS NOT NULL AS \"result\"",
        "params": [
          "\"public\".\"Product\""
        ]
      }
    ]
