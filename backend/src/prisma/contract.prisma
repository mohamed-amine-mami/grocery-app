// use prisma-8

enum UserRole {
  OWNER
  CLIENT
}

/// How a product is sold. Quantities are integers in the unit's base:
/// PIECE = pieces, KG = grams, L = millilitres.
enum SaleUnit {
  PIECE
  KG
  L
}

/// Where an order is in its life. Allowed transitions live in code, not here.
enum OrderStatus {
  PENDING
  CONFIRMED
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
  NO_SHOW
}

/// Who caused an order status change.
enum OrderActorType {
  CLIENT
  OWNER
  SYSTEM
  CHANNEL
}

model User {
  id             Int      @id @default(autoincrement())
  name           String
  email          String   @unique
  password       String
  phoneNumber    String   @unique
  whatsappNumber String?
  photo          String?
  /// Cloudinary public id of the managed photo; never exposed by the API.
  photoPublicId  String?
  role           UserRole @default(CLIENT)
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()

  @@check(expression: "\"photoPublicId\" IS NULL OR \"photo\" IS NOT NULL", name: "user_photo_public_id_needs_photo")
}

model Store {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  photo       String?
  /// Cloudinary public id of the managed photo; never exposed by the API.
  photoPublicId String?
  address     String
  latitude    Float?
  longitude   Float?
  isOpen      Boolean  @default(false)
  ownerId     Int      @unique
  owner       User     @relation(fields: [ownerId], references: [id])
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  @@check(expression: "(latitude IS NULL) = (longitude IS NULL)", name: "store_coordinates_together")
  @@check(expression: "\"photoPublicId\" IS NULL OR \"photo\" IS NOT NULL", name: "store_photo_public_id_needs_photo")
}

/// Global catalog category — curated through the catalog import, never by owners.
model Category {
  id          Int               @id @default(autoincrement())
  /// Stable technical identifier used by the importer and automation; never reused.
  slug        String            @unique
  name        String
  description String?
  photo       String?
  archivedAt  TimestamptzString?
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  // Names are unique among *active* categories; archived ones free the name.
  @@index(expression: "lower(\"name\")", unique: true, where: "(\"archivedAt\" IS NULL)", name: "category_active_name_unique")
  @@check(expression: "length(btrim(\"name\")) > 0", name: "category_name_not_blank")
  @@check(expression: "\"slug\" ~ '^[a-z0-9]+(-[a-z0-9]+)*$'", name: "category_slug_format")
}

/// Global catalog brand — a small reference entity, curated through the catalog
/// import, never by owners. Optional on a product; never archived in V1.
model Brand {
  id        Int               @id @default(autoincrement())
  /// Stable technical identifier used by the importer; never reused.
  slug      String            @unique
  name      String
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@index(expression: "lower(\"name\")", unique: true, name: "brand_name_unique")
  @@check(expression: "length(btrim(\"name\")) > 0", name: "brand_name_not_blank")
  @@check(expression: "\"slug\" ~ '^[a-z0-9]+(-[a-z0-9]+)*$'", name: "brand_slug_format")
}

/// Global catalog product: the canonical identity. Carries *defaults* only —
/// price, availability, stock and the rules a store actually sells with live on
/// StoreProduct.
model Product {
  id                  Int               @id @default(autoincrement())
  /// Stable technical identifier; renaming a product keeps its slug.
  slug                String            @unique
  categoryId          Int
  category            Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// Optional: plenty of products have no brand.
  brandId             Int?
  brand               Brand?            @relation(fields: [brandId], references: [id], onDelete: Restrict)
  name                String
  description         String?
  photo               String?
  defaultSaleUnit     SaleUnit
  defaultMinQuantity  Int
  defaultQuantityStep Int
  defaultMaxQuantity  Int?
  archivedAt          TimestamptzString?
  createdAt           TimestamptzString @default(now())
  updatedAt           temporal.updatedAtString()

  // Active names are unique per brand: the same name under two brands is two products,
  // and a brandless name is unique among the brandless ones (NULL never compares equal,
  // so it needs its own index).
  @@index(expression: "lower(\"name\"), \"brandId\"", unique: true, where: "(\"archivedAt\" IS NULL AND \"brandId\" IS NOT NULL)", name: "product_active_name_brand_unique")
  @@index(expression: "lower(\"name\")", unique: true, where: "(\"archivedAt\" IS NULL AND \"brandId\" IS NULL)", name: "product_active_name_brandless_unique")
  @@index([categoryId])
  @@index([brandId])
  @@check(expression: "length(btrim(\"name\")) > 0", name: "product_name_not_blank")
  @@check(expression: "\"slug\" ~ '^[a-z0-9]+(-[a-z0-9]+)*$'", name: "product_slug_format")
  @@check(expression: "\"defaultMinQuantity\" > 0", name: "product_default_min_positive")
  @@check(expression: "\"defaultQuantityStep\" > 0", name: "product_default_step_positive")
  @@check(expression: "\"defaultMinQuantity\" % NULLIF(\"defaultQuantityStep\", 0) = 0", name: "product_default_min_aligned_to_step")
  @@check(expression: "\"defaultMaxQuantity\" IS NULL OR \"defaultMaxQuantity\" >= \"defaultMinQuantity\"", name: "product_default_max_not_below_min")
  @@check(expression: "\"defaultMaxQuantity\" IS NULL OR \"defaultMaxQuantity\" % NULLIF(\"defaultQuantityStep\", 0) = 0", name: "product_default_max_aligned_to_step")
}

/// How one store sells one catalog product. The only place store-specific
/// commercial configuration lives. Rows are archived, never deleted: both
/// foreign keys are Restrict, so history (and future order items) can rely on them.
model StoreProduct {
  id            Int               @id @default(autoincrement())
  storeId       Int
  store         Store             @relation(fields: [storeId], references: [id], onDelete: Restrict)
  productId     Int
  product       Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  saleUnit      SaleUnit
  priceMillimes Int
  minQuantity   Int
  quantityStep  Int
  maxQuantity   Int?
  /// Stock is optional per store product; when tracked it is in base units.
  trackStock    Boolean           @default(false)
  stockQuantity Int?
  isAvailable   Boolean           @default(true)
  archivedAt    TimestamptzString?
  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()

  @@unique([storeId, productId])
  @@check(expression: "\"priceMillimes\" > 0", name: "store_product_price_positive")
  @@check(expression: "\"minQuantity\" > 0", name: "store_product_min_positive")
  @@check(expression: "\"quantityStep\" > 0", name: "store_product_step_positive")
  @@check(expression: "\"minQuantity\" % NULLIF(\"quantityStep\", 0) = 0", name: "store_product_min_aligned_to_step")
  @@check(expression: "\"maxQuantity\" IS NULL OR \"maxQuantity\" >= \"minQuantity\"", name: "store_product_max_not_below_min")
  @@check(expression: "\"maxQuantity\" IS NULL OR \"maxQuantity\" % NULLIF(\"quantityStep\", 0) = 0", name: "store_product_max_aligned_to_step")
  @@check(expression: "\"stockQuantity\" IS NULL OR \"stockQuantity\" >= 0", name: "store_product_stock_not_negative")
  @@check(expression: "\"trackStock\" = (\"stockQuantity\" IS NOT NULL)", name: "store_product_stock_tracking_pairing")
}

/// One customer's order at one store. Pickup only, paid at the store, so there
/// are no payment columns. History (confirmed, ready, cancelled by whom and why)
/// lives in OrderStatusEvent, not in per-status columns. Orders are never
/// deleted: every foreign key is Restrict.
model Order {
  id                Int               @id @default(autoincrement())
  /// Short, human-friendly reference and pickup code. Not an authentication secret.
  code              String            @unique
  customerId        Int
  customer          User              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  storeId           Int
  store             Store             @relation(fields: [storeId], references: [id], onDelete: Restrict)
  status            OrderStatus       @default(PENDING)
  /// Advisory pickup time, not a slot.
  requestedPickupAt TimestamptzString
  /// Sum of the lines that are not removed, in millimes; computed by the server.
  totalMillimes     Int
  /// Chosen by the client for one creation attempt; unique per customer.
  idempotencyKey    String
  createdAt         TimestamptzString @default(now())
  updatedAt         temporal.updatedAtString()

  @@unique([customerId, idempotencyKey])
  @@index([storeId, status])
  @@index([customerId, createdAt])
  @@check(expression: "\"code\" ~ '^[A-Z0-9]{4,12}$'", name: "order_code_format")
  @@check(expression: "\"totalMillimes\" > 0", name: "order_total_positive")
  @@check(expression: "length(btrim(\"idempotencyKey\")) > 0 AND length(\"idempotencyKey\") <= 100", name: "order_idempotency_key_valid")
  @@check(expression: "\"requestedPickupAt\" > \"createdAt\"", name: "order_pickup_after_creation")
}

/// A historical order line: name, unit and price are snapshots, so the order
/// stays readable whatever happens to the catalog. A removed line stays here
/// with removedAt set and no longer counts toward the total.
model OrderItem {
  id                       Int               @id @default(autoincrement())
  orderId                  Int
  order                    Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  storeProductId           Int
  storeProduct             StoreProduct      @relation(fields: [storeProductId], references: [id], onDelete: Restrict)
  productNameSnapshot      String
  saleUnitSnapshot         SaleUnit
  /// Price of ONE sale unit when the order was placed, in millimes.
  unitPriceMillimes        Int
  /// Requested quantity in base units (pieces / g / mL).
  quantity                 Int
  lineTotalMillimes        Int
  /// How much stock was actually taken from the StoreProduct for this line:
  /// 0 for an untracked product. A historical fact; never derived from the
  /// StoreProduct's current stock.
  stockDecrementedQuantity Int               @default(0)
  removedAt                TimestamptzString?
  createdAt                TimestamptzString @default(now())

  @@unique([orderId, storeProductId])
  @@check(expression: "length(btrim(\"productNameSnapshot\")) > 0", name: "order_item_name_not_blank")
  @@check(expression: "\"unitPriceMillimes\" > 0", name: "order_item_price_positive")
  @@check(expression: "\"quantity\" > 0", name: "order_item_quantity_positive")
  @@check(expression: "\"lineTotalMillimes\" >= 0", name: "order_item_line_total_not_negative")
  @@check(expression: "\"stockDecrementedQuantity\" >= 0 AND \"stockDecrementedQuantity\" <= \"quantity\"", name: "order_item_stock_decrement_within_quantity")
}

/// Append-only history of an order's status changes. Written in the same
/// transaction as the change; never updated or deleted (hence no updatedAt).
model OrderStatusEvent {
  id         Int               @id @default(autoincrement())
  orderId    Int
  order      Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  /// Null only for the creation event.
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actorType  OrderActorType
  /// The user behind a CLIENT or OWNER action; null for SYSTEM.
  actorId    Int?
  actor      User?             @relation(fields: [actorId], references: [id], onDelete: Restrict)
  reason     String?
  createdAt  TimestamptzString @default(now())

  @@index([orderId, createdAt])
  @@check(expression: "\"fromStatus\" IS NOT NULL OR \"toStatus\" = 'PENDING'", name: "order_event_creation_is_pending")
  @@check(expression: "\"fromStatus\" IS NULL OR \"fromStatus\" <> \"toStatus\"", name: "order_event_status_changes")
  @@check(expression: "\"actorType\" NOT IN ('CLIENT', 'OWNER') OR \"actorId\" IS NOT NULL", name: "order_event_user_actor_has_id")
  @@check(expression: "\"actorType\" <> 'SYSTEM' OR \"actorId\" IS NULL", name: "order_event_system_has_no_actor")
  @@check(expression: "\"reason\" IS NULL OR (length(btrim(\"reason\")) > 0 AND length(\"reason\") <= 500)", name: "order_event_reason_valid")
}
